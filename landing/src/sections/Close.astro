---
import { REPO } from '../data/site';
---

<section class="band close" id="start">
  <div class="close__glow" aria-hidden="true"></div>
  <div class="shell close__inner">
    <p class="eyebrow reveal">Get started</p>
    <h2 class="display reveal" data-delay="1" style="max-width:14ch">
      Build your <span class="accent">AI factory</span> with us.
    </h2>
    <p class="lede reveal" data-delay="2" style="margin-top:2rem">
      Open source under Apache 2.0, built and maintained by EPAM engineers who run it
      on their own delivery.
    </p>
    <div class="close__actions reveal" data-delay="3">
      <a class="btn btn--solid" href="#install">Install DMTools</a>
      <a class="btn btn--ghost" href={REPO} target="_blank" rel="noopener">Star on GitHub</a>
    </div>
  </div>
</section>
