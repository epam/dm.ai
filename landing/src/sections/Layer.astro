---
import BridgeDiagram from '../components/BridgeDiagram.astro';
---

<section class="band band--tint" id="layer">
  <div class="shell">
    <div class="layer__lead">
      <div>
        <p class="eyebrow reveal">The answer</p>
        <h2 class="headline reveal" data-delay="1">
          One orchestration<br /><span class="accent">layer.</span>
        </h2>
        <p class="subhead reveal" data-delay="2" style="margin-top:2rem">
          Between your AI agents and your enterprise systems — one CLI, every
          integration they need.
        </p>
        <p class="layer__claim reveal" data-delay="3">One CLI for the whole toolchain.</p>
      </div>

      <BridgeDiagram />
    </div>
  </div>
</section>
