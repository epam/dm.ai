---
import Page from '../layouts/Page.astro';
import FactorySetup from '../components/FactorySetup.tsx';
import '../styles/factory.css';
---

<Page
  title="Set up your AI factory — DMTools"
  description="Connect a GitHub repository to the DMTools agent factory and @fa universal agent: enter your token and teammate account, and get a ready pull request."
  canonicalPath="factory/"
>
  <section class="band factory-hero">
    <div class="shell">
      <p class="eyebrow">Factory setup</p>
      <h1 class="display">Set up your <span class="accent">AI factory</span> in one PR.</h1>
      <p class="lede" style="margin-top:1.5rem">
        Enter your repository, the AI teammate account and your CI details. DMTools generates the
        autonomous factory workflows, the interactive <code>@fa</code> universal agent, and durable project memory
        (<code>.fah/memory</code>) — then opens the pull request for you.
      </p>
    </div>
  </section>
  <section class="band">
    <div class="shell">
      <FactorySetup client:load />
    </div>
  </section>
</Page>
