---
import { asset } from '../data/content';

interface Props {
  href?: string;
  label?: string;
  /** Force a logo variant. Default follows the active colour theme. */
  logo?: 'auto' | 'light' | 'dark';
}

const { href, label, logo = 'auto' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="brand" href={href} aria-label={label}>
  {logo === 'auto' ? (
    <>
      <img class="brand__epam brand__epam--auto-light" src={asset('assets/epam_logo_white.svg')} alt="EPAM" width="59" height="22" />
      <img class="brand__epam brand__epam--auto-dark" src={asset('assets/epam_logo_dark.svg')} alt="EPAM" width="59" height="22" />
    </>
  ) : (
    <img class={`brand__epam brand__epam--${logo}`} src={asset(logo === 'light' ? 'assets/epam_logo_white.svg' : 'assets/epam_logo_dark.svg')} alt="EPAM" width="59" height="22" />
  )}
  <span class="brand__rule" aria-hidden="true"></span>
  <span class="brand__name">DMTools</span>
</Tag>
