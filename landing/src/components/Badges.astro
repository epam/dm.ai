---
const REPO = 'https://github.com/epam/dm.ai';

const badges = [
  { label: 'release', value: 'v1.7.239', href: `${REPO}/releases/latest` },
  { label: 'coverage', value: '82%', href: `${REPO}/actions/workflows/coverage.yml` },
  { label: 'branches', value: '70%', href: `${REPO}/actions/workflows/coverage.yml` },
  { label: 'license', value: 'Apache 2.0', href: `${REPO}/blob/main/LICENSE` },
  { label: 'stars', value: '69', href: `${REPO}/stargazers` },
  { label: 'forks', value: '14', href: `${REPO}/network/members` },
  { label: 'contributors', value: '12', href: `${REPO}/graphs/contributors` },
  { label: 'downloads', value: '86.2k', href: `${REPO}/releases` },
  { label: 'last commit', value: 'today', href: `${REPO}/commits/main` },
  { label: 'Java', value: '17+', href: 'https://adoptium.net/' },
];
---

<div class="badges" aria-label="Project badges">
  {badges.map((badge) => (
    <a class="badge" href={badge.href} target="_blank" rel="noopener">
      <span class="badge__label">{badge.label}</span>
      <span class="badge__value">{badge.value}</span>
    </a>
  ))}
</div>
